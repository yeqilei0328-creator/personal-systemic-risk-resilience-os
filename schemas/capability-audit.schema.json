{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability-audit.schema.json",
  "title": "Capability Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "capability_id",
    "domain",
    "criticality",
    "verification_status",
    "availability_status",
    "autonomy_days",
    "dependencies",
    "single_points_of_failure",
    "maintenance_status",
    "replenishment_status",
    "last_verified_at",
    "evidence_refs",
    "data_sensitivity"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^cpa-[A-Za-z0-9._-]+$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^cap-[A-Za-z0-9._-]+$"
    },
    "domain": {
      "enum": [
        "cash_flow",
        "liquidity",
        "asset_disposition",
        "industrial_space",
        "land",
        "energy",
        "water",
        "food",
        "mobility",
        "physical_ai",
        "communications",
        "medical",
        "sanitation",
        "tools_spares",
        "offline_knowledge",
        "people_network"
      ]
    },
    "criticality": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "verification_status": {
      "enum": [
        "stated",
        "measured",
        "field_tested",
        "audited"
      ]
    },
    "availability_status": {
      "enum": [
        "unknown",
        "unavailable",
        "degraded",
        "available"
      ]
    },
    "autonomy_days": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency_id",
          "kind",
          "critical",
          "backup_status"
        ],
        "properties": {
          "dependency_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "power",
              "water",
              "network",
              "fuel",
              "logistics",
              "supplier",
              "personnel",
              "software",
              "hardware",
              "finance",
              "other"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "backup_status": {
            "enum": [
              "none",
              "partial",
              "ready",
              "unknown"
            ]
          }
        }
      }
    },
    "single_points_of_failure": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maintenance_status": {
      "enum": [
        "current",
        "due",
        "overdue",
        "unknown"
      ]
    },
    "replenishment_status": {
      "enum": [
        "available",
        "constrained",
        "unavailable",
        "unknown"
      ]
    },
    "conversion_latency_hours": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_test_due": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "data_sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    }
  }
}
