{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/replay-suite-summary.schema.json",
  "title": "Replay Suite Summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "result_ids",
    "total_steps",
    "passed_steps",
    "failed_steps",
    "false_positive_count",
    "false_negative_count",
    "code_mismatch_count",
    "duplicate_control_failure_count",
    "deescalation_falsification_failure_count",
    "generated_at",
    "sensitivity"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "suite_id": {
      "type": "string",
      "pattern": "^rps-[A-Za-z0-9._-]+$"
    },
    "result_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^rpr-[A-Za-z0-9._-]+$"
      }
    },
    "total_steps": {
      "type": "integer",
      "minimum": 0
    },
    "passed_steps": {
      "type": "integer",
      "minimum": 0
    },
    "failed_steps": {
      "type": "integer",
      "minimum": 0
    },
    "false_positive_count": {
      "type": "integer",
      "minimum": 0
    },
    "false_negative_count": {
      "type": "integer",
      "minimum": 0
    },
    "code_mismatch_count": {
      "type": "integer",
      "minimum": 0
    },
    "duplicate_control_failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "deescalation_falsification_failure_count": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    }
  }
}
